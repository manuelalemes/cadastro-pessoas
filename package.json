{
  "name": "cadastro-pessoas",
  "version": "1.0.0",
  "description": "CRUD de pessoas (CPF, nome e data de nascimento) com cálculo de idade, desenvolvido com TDD",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/servidor.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"tests/integration/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"public/mascara.js\" \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.6.0"
  },
  "license": "MIT"
}
